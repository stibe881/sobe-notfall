{
  "name": "sobe-notfall-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Alarmserver für SOBE Notfall – gemeinsamer Datenbestand für Webportal und iOS-App",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "serve": "bash scripts/run.sh",
    "reset-admin": "tsx src/reset-admin.ts",
    "accounts": "tsx src/accounts.ts",
    "sitzungen": "tsx src/sitzungen.ts",
    "test": "tsx src/twilio.test.ts && tsx src/netz.test.ts && tsx src/pushnutzlast.test.ts && tsx src/planwahl.test.ts && tsx src/eskalation.test.ts && tsx src/aufbewahrung.test.ts && tsx src/test.ts",
    "sicherung": "node scripts/sicherung.mjs",
    "pruefe-datenbank": "node scripts/pruefe-datenbank.mjs"
  },
  "dependencies": {
    "@sobe/shared-types": "1.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
