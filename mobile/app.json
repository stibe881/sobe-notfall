{
  "expo": {
    "name": "Notfall",
    "slug": "sonnenberg-notfall",
    "scheme": "sobenotfall",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#c81e1e"
        }
      ],
      "expo-live-activity",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SOBE Notfall nutzt den Standort, um zu erkennen, an welchem Firmenstandort und in welchem Raum Sie sich befinden – damit Alarme die richtigen Personen erreichen und Helfende Sie finden. Die Position im Gebäude wird nur mit einem Alarm übermittelt.",
          "locationAlwaysAndWhenInUsePermission": "SOBE Notfall erkennt auch im Hintergrund, ob Sie einen Firmenstandort betreten oder verlassen, damit Alarme die Personen vor Ort erreichen. Übertragen wird nur der Standort-Name, nie eine GPS-Position.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 30
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./modules/meridian-indoor/app.plugin.js"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#0f172a",
    "primaryColor": "#c81e1e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.sonnenberg.notfall",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "SOBE Notfall verbindet sich mit dem Alarmserver im Schulnetz, um Benutzerkonten, Szenarien und Alarme zu laden.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.critical-alerts": true
      }
    },
    "android": {
      "package": "ch.sonnenberg.notfall",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "349fb6b1-8d68-4457-b89f-d6c85eed30aa"
      }
    }
  }
}
